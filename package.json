{
  "name": "vuepress-plugin-social-share",
  "version": "2.0.0-beta.31",
  "description": "Social sharing plugin for VuePress",
  "keywords": [
    "facebook",
    "share",
    "sns",
    "social",
    "social-share",
    "twitter",
    "vuepress",
    "vuepress-plugin",
    "weibo"
  ],
  "homepage": "https://social-share.ntnyq.com",
  "bugs": {
    "url": "https://github.com/ntnyq/vuepress-plugin-social-share/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": "ntnyq/vuepress-plugin-social-share",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/node/index.js",
    "./client": "./dist/client/index.js",
    "./client/*": "./dist/client/*"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsdown",
    "build:site": "run-s build docs:build",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vuepress/helper": "^2.0.0-rc.131",
    "deepmerge": "^4.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bumpp": "^12.1.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vuepress": "^2.0.0-rc.31"
  },
  "peerDependencies": {
    "vuepress": "^2.0.0-rc.30"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.19.0"
}
