{
  "name": "vuepress-plugin-social-share",
  "type": "module",
  "version": "2.0.0-beta.30",
  "packageManager": "pnpm@10.12.1",
  "description": "Social sharing plugin for VuePress",
  "keywords": [
    "facebook",
    "share",
    "sns",
    "social",
    "social-share",
    "twitter",
    "vuepress",
    "vuepress-plugin",
    "weibo"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://social-share.ntnyq.com",
  "repository": "ntnyq/vuepress-plugin-social-share",
  "bugs": {
    "url": "https://github.com/ntnyq/vuepress-plugin-social-share/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/node/index.js",
    "./client": "./dist/client/index.js",
    "./client/*": "./dist/client/*"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:site": "run-s build docs:build",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version release:publish",
    "release:check": "run-s lint typecheck test",
    "release:publish": "pnpm publish --tag next",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vuepress": "^2.0.0-rc.19"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "@vuepress/helper": "^2.0.0-rc.108",
    "deepmerge": "^4.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^5.0.0-beta.6",
    "@ntnyq/prettier-config": "^2.2.0",
    "@types/node": "^22.15.31",
    "bumpp": "^10.1.1",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "nano-staged": "^0.8.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.5.3",
    "tsdown": "^0.12.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "vuepress": "^2.0.0-rc.23"
  },
  "nano-staged": {
    "*.{js,ts,cjs,mjs,vue,md,yml,yaml,json}": "eslint --fix",
    "*.{css,scss,html}": "prettier -uw"
  }
}
