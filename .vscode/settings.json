{
  "oxc.enable": true,
  "eslint.enable": true,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "eslint.validate": [
    "vue",
    "toml",
    "yaml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "typescript.experimental.useTsgo": true,
  "cSpell.words": [
    "bumpp",
    "changelogithub",
    "customed",
    "dbaeumer",
    "esbenp",
    "esbuild",
    "goyfe",
    "iconify",
    "linkedin",
    "ntnyq",
    "oxfmt",
    "pnpm",
    "qrcode",
    "rgba",
    "serializers",
    "shiki",
    "tsbuildinfo",
    "tsdown",
    "unplugin",
    "unrs",
    "vite",
    "Vitest",
    "vuepress",
    "weibo"
  ],
  "cSpell.allowCompoundWords": true
}
